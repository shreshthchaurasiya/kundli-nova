VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Never rename this to VITE_GEMINI_API_KEY because VITE_* values
# are bundled into browser JavaScript.
GEMINI_API_KEY=

# Optional local API proxy target when the Express server runs separately.
VITE_API_PROXY_TARGET=http://localhost:3000
